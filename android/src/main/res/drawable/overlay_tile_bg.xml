<?xml version="1.0" encoding="utf-8"?>
<!-- Hero tile: azure gradient rounded square (mirrors the app's sheet hero). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FF5AA0E0"
        android:endColor="#FF2F6FB8" />
    <stroke
        android:width="1dp"
        android:color="#4DFFFFFF" />
</shape>
